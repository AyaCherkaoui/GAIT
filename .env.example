# AI backend: ollama (default, free, local), groq, gemini, openrouter, grok (xAI; "xai" also works) or anthropic.
# Leave empty to use ollama.
GAIT_PROVIDER=ollama

# --- Free testing (no card) ---
# Ollama (fully private, runs on this computer): install from https://ollama.com,
# run `ollama pull llama3.1:8b`. No key needed.
# OLLAMA_HOST=http://localhost:11434
# Groq (best hosted free pick): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini: key from https://aistudio.google.com/apikey. The free tier may use your prompts to improve
# Google products, so do not paste real student text.
GEMINI_API_KEY=
# OpenRouter: key from https://openrouter.ai/keys (uses :free models)
OPENROUTER_API_KEY=

# --- Paid ---
# xAI (Grok): https://console.x.ai
XAI_API_KEY=
# Claude, the production target: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model overrides
# (defaults depend on the provider; ollama: llama3.1:8b / llama3.2:3b)
# GAIT_MODEL_SMART=
# GAIT_MODEL_FAST=
# Google OAuth "Desktop app" client, used by npm run sync-aria
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The id of the ARIA folder (the last part of its Drive URL)
ARIA_FOLDER_ID=

# Sign-in (Google). Uses the same OAuth client as above.
# In Google Cloud Console, add this exact redirect URI to the client: <APP_URL>/api/auth/callback
# (Google may only accept it if the client type allows it; a "Web application" client always does.)
# Required: at least 32 random characters that sign the login cookie (make one with: openssl rand -base64 32)
AUTH_SECRET=
# Where the app is opened in the browser (no trailing slash). Use https:// when hosted.
APP_URL=http://localhost:3100
# Optional: only let this email domain sign in (for example augustana.edu). Empty = any Google account.
ALLOWED_EMAIL_DOMAIN=
# The director's email. Always an active director, so the director can never be locked out. The director adds tutors at /admin/tutors; only people on that list can sign in.
DIRECTOR_EMAIL=
# Optional: path of the SQLite file (default: gait.db in the project folder)
# GAIT_DB=

# Testing only: adds a "Reset role" button and makes a chosen role take effect at once. Never set where real people sign in.
# GAIT_TEST_TOOLS=1
