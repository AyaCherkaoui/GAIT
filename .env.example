# AI backend: anthropic (default), ollama (free, local) or grok (xAI)
GAIT_PROVIDER=ollama
# Only for GAIT_PROVIDER=grok (https://console.x.ai)
XAI_API_KEY=
# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model overrides
# (defaults depend on the provider; ollama: llama3.1:8b / llama3.2:3b)
# GAIT_MODEL_SMART=
# GAIT_MODEL_FAST=
# Google OAuth "Desktop app" client, used by npm run sync-aria
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The id of the ARIA folder (the last part of its Drive URL)
ARIA_FOLDER_ID=
