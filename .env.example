# Which model provider to use: groq, ollama, gemini, openrouter, xai or anthropic.
# Leave empty to use the first one with a key set (anthropic, groq, gemini, openrouter, xai),
# or a running local Ollama if none has a key.
GAIT_PROVIDER=

# --- Free testing (no card) ---
# 1. Groq (best first pick): sign up at https://console.groq.com/keys
GROQ_API_KEY=
# 2. Ollama (fully private, runs on this computer): install from https://ollama.com,
#    run `ollama pull llama3.1:8b`, then set GAIT_PROVIDER=ollama. No key needed.
#    OLLAMA_BASE_URL=http://localhost:11434/v1
# 3. Gemini: key from https://aistudio.google.com/apikey. The free tier may use your prompts to improve
#    Google products, so do not paste real student text.
GEMINI_API_KEY=
# OpenRouter: key from https://openrouter.ai/keys (uses :free models)
OPENROUTER_API_KEY=

# --- Paid ---
# xAI (Grok): https://console.x.ai
XAI_API_KEY=
# Claude, the production target: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are listed in AGENTS.md)
GAIT_MODEL_SMART=
GAIT_MODEL_FAST=

# Google OAuth "Desktop app" client, used by npm run sync-aria
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The id of the ARIA folder (the last part of its Drive URL)
ARIA_FOLDER_ID=
