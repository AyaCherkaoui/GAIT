# Which model provider to use: xai or anthropic.
# Default: xai when XAI_API_KEY is set, otherwise anthropic.
GAIT_PROVIDER=
# xAI (Grok) API key (https://console.x.ai)
XAI_API_KEY=
# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: grok-4.7 / grok-4.3 on xai, claude-sonnet-5-5 / claude-haiku-5-5 on anthropic)
GAIT_MODEL_SMART=
GAIT_MODEL_FAST=
# Google OAuth "Desktop app" client, used by npm run sync-aria
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The id of the ARIA folder (the last part of its Drive URL)
ARIA_FOLDER_ID=
